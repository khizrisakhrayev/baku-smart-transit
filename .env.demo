# Demo settings: alerts after 30 s of "high" reports, a 6-minute synthetic rush hour
# (forecast warnings appear in about 1-2 minutes). Used by run_demo.ps1 and by
# `docker compose --env-file .env.demo up --build`.
ANOMALY_WINDOW_SEC=30
RUSH_PERIOD_MIN=6
SYNTHETIC_REPORTS=1
SIM_SEED=42
MAX_REPORT_DISTANCE_M=0
